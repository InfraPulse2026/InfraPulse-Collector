#!/bin/sh /etc/rc.common
# Administrator installs binary/config/user/state; this script changes no UCI,
# NTP, firewall, network device or BMC settings. Runtime validation is manual.
START=95
STOP=10
USE_PROCD=1

start_service() {
    [ -x /usr/bin/infrapulse-agent ] || return 1
    [ -r /etc/infrapulse/config.yaml ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/infrapulse-agent run --config /etc/infrapulse/config.yaml
    procd_set_param user infrapulse
    procd_set_param group infrapulse
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/infrapulse/config.yaml
    procd_close_instance
}
